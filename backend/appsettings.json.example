{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=PregnantWebDb;Username=postgres;Password=YOUR_DB_PASSWORD"
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:4200"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "Issuer": "PregnantWeb",
    "Audience": "PregnantWeb",
    "ExpiresInSeconds": 28800
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "YOUR_GMAIL_ADDRESS",
    "Password": "YOUR_GMAIL_APP_PASSWORD",
    "FromAddress": "YOUR_GMAIL_ADDRESS",
    "FromName": "PregnantWeb"
  },
  "Resend": {
    "ApiKey": "YOUR_RESEND_API_KEY",
    "FromAddress": "onboarding@resend.dev"
  },
  "Notifications": {
    "OwnerEmail": "YOUR_ADMIN_EMAIL"
  }
}
